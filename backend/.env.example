PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retain
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# An admin account is created/updated on startup from these values
ADMIN_NAME=Retain Admin
ADMIN_EMAIL=admin@retain.app
ADMIN_PASSWORD=ChangeMe123!
# Set to true when the database requires SSL (most hosted Postgres providers)
DATABASE_SSL=false
